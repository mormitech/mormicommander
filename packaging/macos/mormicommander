#!/bin/sh
# The `mormicommander` command of macOS: mormicommander [left folder] [right folder]. The Homebrew cask links this script
# into the path, and not the program itself: started by the program's own path through a link, the system does not
# know the app. Here macOS starts the app as it does from Finder, and the prompt comes back at once. Flags (--demo,
# --control ...) go to the app as they are; folders are made absolute first, because `open` starts the app elsewhere.
src=$0
while [ -L "$src" ]; do # follow the links of the command to this file, to find the app that holds it
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
app=$(cd "$(dirname "$src")/../../.." && pwd) # mormicommander.app/Contents/Resources/bin/mormicommander
args=""
for a in "$@"; do
  case $a in
    -*) ;;
    /*) ;;
    *) [ -e "$a" ] && a=$(cd "$a" 2>/dev/null && pwd || echo "$PWD/$a") ;;
  esac
  args="$args$(printf '%s\n' "$a" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/") "
done
eval "set -- $args"
set -- -n -a "$app" --args "$@"
if [ -n "$MORMICOMMANDER_LAUNCH_DRYRUN" ]; then # (for the test: says what it would do)
  echo open "$@"
  exit 0
fi
exec open "$@"
