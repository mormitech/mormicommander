<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Info.plist of build/bin/mormicommander.app. scripts/build.sh fills in the @...@ values from wails.json. -->
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>@PRODUCT_NAME@</string>
        <key>CFBundleDisplayName</key>
        <string>@PRODUCT_NAME@</string>
        <key>CFBundleExecutable</key>
        <string>mormicommander</string>
        <key>CFBundleIdentifier</key>
        <string>@BUNDLE_ID@</string>
        <key>CFBundleVersion</key>
        <string>@VERSION@</string>
        <key>CFBundleGetInfoString</key>
        <string>@COMMENTS@</string>
        <key>CFBundleShortVersionString</key>
        <string>@VERSION@</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>
        <key>LSMinimumSystemVersion</key>
        <string>13.0.0</string>
        <key>NSHighResolutionCapable</key>
        <string>true</string>
        <key>NSHumanReadableCopyright</key>
        <string>@COPYRIGHT@</string>
        <key>NSLocalNetworkUsageDescription</key>
        <string>mormiCommander looks for file servers on your local network, and connects to the one you choose, only when you press the Network button or connect a network drive.</string>
        <key>NSBonjourServices</key>
        <array>
            <string>_smb._tcp</string>
            <string>_afpovertcp._tcp</string>
            <string>_nfs._tcp</string>
        </array>
    </dict>
</plist>
